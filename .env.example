# ─── Application ──────────────────────────────────────────────
APP_NAME=Gallery Vault
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000

# ─── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=gallery_vault
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_REFRESH_SECRET_KEY=super-refresh-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=gallery_vault
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890
TELEGRAM_SESSION_STRING=your_generated_string_session

# ─── Brevo Email API ──────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=send@mohinbd.com
BREVO_SENDER_NAME=Gallery Vault
BREVO_API_BASE_URL=https://api.brevo.com/v3

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ─── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
