PROJECT_NAME="Gallery Vault API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security
JWT_SECRET_KEY="generate-a-secure-random-256-bit-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/gallery_vault?retryWrites=true&w=majority"
MONGODB_DB_NAME="gallery_vault"

# Telethon
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH="your_telegram_api_hash"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# Brevo Email
BREVO_API_KEY="your_brevo_api_key"
