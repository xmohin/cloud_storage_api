APP_NAME="Gallery Vault"
ENVIRONMENT="development"
DEBUG=true
MONGO_URI="mongodb://localhost:27017/gallery_vault"
JWT_SECRET_KEY="replace_with_a_secure_random_key_min_32_chars"
JWT_REFRESH_SECRET_KEY="replace_with_another_secure_random_key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH="your_telegram_api_hash"
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHANNEL_ID=-1001234567890

BREVO_API_KEY="xkeysib-your-key-here"
BREVO_SENDER_EMAIL="send@mohinbd.com"
BREVO_SENDER_NAME="Gallery Vault"

MAX_UPLOAD_SIZE_MB=2000
TEMP_STORAGE_PATH="/tmp/gallery_vault_temp"
